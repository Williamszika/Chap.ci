# =============================================================================
#  Chap.ci — .htaccess de la RACINE du site  (public_html/.htaccess)
#
#  ⚠️ CE FICHIER EST DÉPLOYÉ PAR LE ZIP ET ÉCRASE CELUI DU SERVEUR.
#  Une règle ajoutée à la main sur le serveur serait perdue à la prochaine mise
#  en ligne : ajoutez-la ICI, pas là-bas.
#
#  Depuis le 27/07/2026, il fusionne ce qui vivait dans deux fichiers séparés :
#  le routage SEO (qui était déployé) et les en-têtes de sécurité + cache (qui
#  ne l'étaient pas — ils dormaient dans deploy/htaccess-racine.txt et se
#  faisaient effacer à chaque déploiement).
# =============================================================================

RewriteEngine On

# --- Pages « crawlables » (SEO + aperçus WhatsApp/Facebook) -> seo.php --------
RewriteRule ^annonce/([A-Za-z0-9-]+)/?$ seo.php [L,QSA]
RewriteRule ^vendeur/([A-Za-z0-9-]+)/?$ seo.php [L,QSA]
# Pages d'atterrissage « Vendez votre {catégorie} à {ville} »
RewriteRule ^vendre/([A-Za-z0-9-]+)(/[A-Za-z0-9-]+)?/?$ seo.php [L,QSA]
RewriteRule ^sitemap\.xml$ seo.php [L]

# IndexNow : fichier de vérification {clé}.txt à la racine -> seo.php
# (uniquement si aucun vrai fichier de ce nom n'existe déjà)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([A-Za-z0-9]{8,64})\.txt$ seo.php [L]

# --- URL « propres » des pages publiques -> leur route à dièse ----------------
# L'application est un HashRouter : sa seule vraie URL est https://chap.ci/ et
# tout se joue après le dièse. Sans ces redirections, https://chap.ci/aide et
# https://chap.ci/suppression-compte renvoient une 404 Apache.
#
# Ce n'est pas cosmétique : Google Play EXIGE une URL de suppression de compte
# accessible publiquement et la teste ; l'App Store et la CNIL ivoirienne font
# de même pour la politique de confidentialité. Une 404 sur ces adresses fait
# refuser la fiche. Elles circulent aussi hors de l'application (courriel,
# WhatsApp, en-tête d'un document), où personne ne pense à écrire le dièse.
#
# ⚠️ Le drapeau NE (noescape) est INDISPENSABLE : sans lui, Apache encode le
# dièse en %23 et redirige vers /%23/aide, qui ne mène nulle part.
RewriteRule ^(suppression-compte|confidentialite|conditions|aide|faq|contact|a-propos|publicite|don|explorer|publier)/?$ /#/$1 [R=301,NE,L]

# --- L'application (SPA) et sa page d'accueil --------------------------------
# index.html SEUL. La racine du site est une application statique : aucun
# index.php n'y a de raison d'être. Le laisser dans DirectoryIndex faisait
# qu'une requête explicite vers /index.php partait dans l'interpréteur PHP et
# revenait en 500 au corps vide — signalé par un audit externe le 27/07.
# Un 500 ne divulgue rien ici, mais une erreur serveur qu'on ne s'explique pas
# est une erreur serveur qu'on ne surveille pas.
DirectoryIndex index.html
Options -Indexes

# Toute requête explicite vers /index.php à la racine est une erreur : on répond
# 404 franchement, au lieu de laisser LiteSpeed produire un 500 muet.
# (L'API a son propre index.php, dans /api/, servi par son propre .htaccess :
#  cette règle ne s'applique QU'À la racine.)
RewriteRule ^index\.php$ - [R=404,L]

# --- En-têtes de sécurité ----------------------------------------------------
# Les endpoints /api/ ont déjà les leurs ; ceci couvre les pages du site.
<IfModule mod_headers.c>
  # Empêche le navigateur de « deviner » un type de fichier (anti-sniffing).
  Header always set X-Content-Type-Options "nosniff"
  # Empêche l'affichage du site dans une iframe d'un autre domaine.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Ne divulgue pas l'URL complète en referrer vers les autres sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Restreint la géolocalisation au site lui-même.
  Header always set Permissions-Policy "geolocation=(self)"
  # Force HTTPS pendant 6 mois (le site est déjà en HTTPS).
  Header always set Strict-Transport-Security "max-age=15552000"

  # --- Politique de sécurité du contenu (CSP) — EN MODE RAPPORT --------------
  #
  # Signalée comme absente par l'audit externe du 27/07, à juste titre : c'est
  # la principale défense contre l'injection de script (XSS).
  #
  # ⚠️ Volontairement en « Report-Only » pour l'instant : elle NE BLOQUE RIEN.
  # Une CSP trop stricte posée d'un coup casse silencieusement le paiement, la
  # connexion Google ou la carte — et on ne s'en aperçoit qu'en lisant les
  # plaintes des utilisateurs. On la fait donc d'abord tourner à vide, on relit
  # la console du navigateur sur les parcours réels (accueil, publier, payer,
  # se connecter), puis on la bascule en « Content-Security-Policy » tout court.
  #
  # « report-uri » fait poster au navigateur, tout seul, ce que la politique
  # aurait bloqué. Le serveur agrège ces rapports (table csp_reports) et les
  # ressort dans cron/security → cspViolations. C'est ce relevé qui dira quand
  # on peut passer en mode bloquant sans casser un parcours : tant qu'une
  # origine légitime y figure, la durcir couperait quelque chose.
  #
  # Les domaines listés sont ceux réellement appelés par le code du dépôt :
  #   accounts.google.com          connexion Google (GSI)
  #   googletagmanager.com         Google Analytics 4
  #   connect.facebook.net         pixel Meta + connexion Facebook
  #   analytics.tiktok.com         pixel TikTok (script)
  #   analytics-ipv6.tiktokw.us    pixel TikTok (envoi des evenements) — ce
  #     domaine-la n'apparaît NULLE PART dans le code : c'est le script de
  #     TikTok qui l'appelle. Il a été découvert par les rapports de violation
  #     le 27/07, deux minutes après leur activation. Aucune lecture du dépôt
  #     ne pouvait le deviner.
  #   nominatim.openstreetmap.org  recherche d'adresse
  #   ipapi.co / ipwho.is / api.bigdatacloud.net  localisation approximative
  #   pay.wave.com                 paiement Wave
  # 'unsafe-inline' sur les styles est requis par React (styles en ligne) ;
  # sur les scripts, il l'est par les extraits d'installation des pixels.
  # Les retirer suppose de passer aux nonces — chantier à part, pas ici.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://chap.ci https://accounts.google.com https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://graph.facebook.com https://analytics.tiktok.com https://analytics-ipv6.tiktokw.us https://nominatim.openstreetmap.org https://ipapi.co https://ipwho.is https://api.bigdatacloud.net; frame-src 'self' https://accounts.google.com https://www.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report"
</IfModule>

# --- Cache des fichiers versionnés -------------------------------------------
# Vite renomme chaque fichier avec une empreinte à chaque build : un cache très
# long est donc sûr, puisqu'un changement de contenu produit un nouveau nom et
# ne peut jamais être servi périmé. Sans cette règle, un visiteur qui revient
# retélécharge tout le JS de l'application — ce qui, sur un forfait data
# ivoirien, se paie en francs.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # EXCEPTIONS : le service worker et ses scripts ne portent PAS d'empreinte.
  # Un cache long les figerait et l'application cesserait de se mettre à jour.
  <FilesMatch "^(sw|registerSW|workbox-.+)\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # index.html n'est pas versionné non plus : il doit être revalidé à chaque
  # visite, sinon le navigateur continue de réclamer d'anciens fichiers.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
