# =============================================================================
#  Configuration du backend — copiez ce fichier en « .env »
# =============================================================================

# --- Choix du backend -------------------------------------------------------
# Laissez VITE_BACKEND vide (ou 'supabase') pour utiliser Supabase (par défaut).
# Mettez 'php' pour utiliser le backend PHP/MySQL auto-hébergé (dossier server/,
# hébergement mutualisé type TPE Cloud).
VITE_BACKEND=

# Uniquement en mode PHP : URL de l'API. Sur le même domaine, laissez /api.
VITE_API_URL=/api

# Email(s) de connexion de l'administrateur (séparés par des virgules) : sert
# UNIQUEMENT à afficher le lien « Abonnés newsletter (admin) » dans le profil.
# L'accès réel est contrôlé par le serveur (server/config.php → admin_emails).
# Mettez l'email AVEC LEQUEL VOUS VOUS CONNECTEZ à l'app (votre compte).
VITE_ADMIN_EMAILS=bracknetswilliam@gmail.com

# --- Supabase (si VITE_BACKEND n'est pas 'php') -----------------------------
# Trouvez ces valeurs dans Supabase : Project Settings > API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
