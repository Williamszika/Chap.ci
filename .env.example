# =============================================================================
#  Configuration du frontend — copiez ce fichier en « .env » si besoin.
#  Le site est 100 % auto-hébergé sur la base TPE Cloud (backend PHP `server/`).
# =============================================================================

# URL de l'API PHP. Sur le même domaine que le site, laissez /api.
VITE_API_URL=/api

# Email(s) de connexion de l'administrateur (séparés par des virgules) : sert
# UNIQUEMENT à afficher le lien « Abonnés newsletter (admin) » dans le profil.
# L'accès réel est contrôlé par le serveur (server/config.php → admin_emails).
# Mettez l'email AVEC LEQUEL VOUS VOUS CONNECTEZ à l'app (votre compte).
VITE_ADMIN_EMAILS=bracknetswilliam@gmail.com

# Identifiants OAuth publics (optionnels : sinon lus depuis /api/config).
# VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID=
