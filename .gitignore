# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Archives de déploiement générées (zips livrés, à ne pas versionner)
chapci-frontend.zip
chapci-backend.zip
*.zip

# Variables d'environnement (secrets locaux)
.env
.env.*
!.env.example

# Capacitor natif (généré par `npx cap add`)
/android
/ios

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend runtime (base SQLite locale, sauvegardes générées)
server/data/
server/backups/
*.sqlite

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Réglages locaux Claude Code (permissions machine, non partagés)
.claude/settings.local.json

# Clés de signature Android/iOS (à garder hors du dépôt !)
*.jks
*.keystore
android/key.properties

# Remotion — sorties de rendu vidéo (projet autonome, hors build du site)
remotion/out/
