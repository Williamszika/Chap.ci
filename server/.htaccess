# Chap.ci API — route toutes les requêtes /api/* vers index.php
RewriteEngine On
RewriteBase /api/

# Ne pas réécrire les fichiers/dossiers réels
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Protéger la configuration et les données locales éventuelles
<FilesMatch "^(config\.php|smtp\.local\.php)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /api/data/.*

# CORS + en-têtes de sécurité : gérés dynamiquement par index.php (P21), qui
# verrouille l'origine autorisée sur l'adresse du site. On NE force PLUS
# « Access-Control-Allow-Origin: * » ici : ce « Header set » écrasait la valeur
# posée par PHP et rouvrait l'API à n'importe quel site (et empêcherait les
# cookies d'authentification à venir). Laisser PHP faire autorité.
