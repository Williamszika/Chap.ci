{
  "name": "chap-ci",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chap.ci — La marketplace des petites annonces en Côte d'Ivoire (web + app iPhone/Android)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "banc": "esbuild scripts/banc-formulaires.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/banc.mjs --log-level=error && node node_modules/.cache/banc.mjs",
    "banc:push": "php8.5 scripts/push-vecteur.php && node scripts/push-sw-banc.mjs",
    "banc:modeles": "node scripts/banc-modeles.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@imgly/background-removal": "^1.7.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "lucide-react": "^0.454.0",
    "nsfwjs": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.2",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
