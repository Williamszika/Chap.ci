<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Localisation. Sans ces deux lignes, l'écran d'accueil demande la position
      au premier rendu, Android refuse SANS afficher la moindre boîte de
      dialogue, et l'application se rabat en silence sur une estimation par
      adresse IP — qui, en Côte d'Ivoire, place à peu près tout le monde à
      Abidjan-Plateau. « Les annonces près de chez vous » ne voulait donc rien
      dire, et personne ne pouvait le deviner : il n'y avait aucun message.
      Constaté sur la v1.9 (versionCode 10), où seule INTERNET était déclarée.

      COARSE d'abord, FINE ensuite : Android présente à l'utilisateur le choix
      « Position précise / Position approximative », et l'approximative suffit
      largement à trier des annonces par commune.

      Pas de <uses-feature android:name="android.hardware.location.gps" /> :
      cette ligne EXCLUT du Play Store tous les appareils sans puce GPS, et il
      en circule en Côte d'Ivoire. La position leur reste accessible par le
      réseau.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
